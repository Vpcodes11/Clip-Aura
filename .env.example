# Copy this file to .env for local development.
# Never commit real secrets. Production values must live in the host secret manager.

# --- API KEYS ---
GROQ_API_KEY=<groq-api-key>
OPENAI_API_KEY=
PEXELS_API_KEY=

# --- SUPABASE ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>

# --- PAYMENTS (Razorpay) ---
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>
RAZORPAY_PRO_PLAN_ID=<razorpay-pro-plan-id>
RAZORPAY_STUDIO_PLAN_ID=<razorpay-studio-plan-id>
RAZORPAY_AGENCY_PLAN_ID=<razorpay-agency-plan-id>
RAZORPAY_CREDIT_PACK_ITEM_ID=<razorpay-credit-pack-item-id>

# --- FRONTEND PUBLIC ENV ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
NEXT_PUBLIC_DEV_MODE=false

# --- INFRASTRUCTURE ---
ENVIRONMENT=development
DEV_MODE=false
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REDIS_PASSWORD=<local-redis-password>
REDIS_URL=redis://:<local-redis-password>@redis:6379/0
DATABASE_URL=sqlite:///./runtime/db/clip_aura.db
OUTPUT_DIR=./runtime/renders
PREVIEW_SIGNING_SECRET=<random-preview-signing-secret>
LEAD_HASH_SALT=<random-lead-hash-salt>

# --- TIMEOUTS / WORKERS ---
AI_API_TIMEOUT_SECONDS=120
AI_API_MAX_RETRIES=2
FFMPEG_TIMEOUT_SECONDS=300
FFPROBE_TIMEOUT_SECONDS=30
THUMBNAIL_TIMEOUT_SECONDS=30
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540

# --- STORAGE ---
STORAGE_MODE=local
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
