# ⚠️ This is an EXAMPLE template. Copy to .env.production and fill in REAL values.
# NEVER commit .env.production to git.
# After a secret leak, rotate ALL keys at their providers immediately.

# --- API KEYS (obtain from Groq console, OpenAI dashboard, Pexels API) ---
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
PEXELS_API_KEY=your-pexels-api-key-here

# --- SUPABASE (obtain from Supabase dashboard → Settings → API) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key


# --- FRONTEND PUBLIC ENV (NEXT_PUBLIC_ prefix makes these available client-side) ---
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_DEV_MODE=false

# --- PAYMENTS — Razorpay (obtain from Razorpay dashboard → Settings → API keys) ---
RAZORPAY_KEY_ID=rzp_live_your-key-id
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
RAZORPAY_PRO_PLAN_ID=plan_your-pro-plan-id
RAZORPAY_STUDIO_PLAN_ID=plan_your-studio-plan-id
RAZORPAY_AGENCY_PLAN_ID=plan_your-agency-plan-id
RAZORPAY_CREDIT_PACK_ITEM_ID=item_your-credit-pack-id

# --- INFRASTRUCTURE ---
ENVIRONMENT=production
DEV_MODE=false
BASE_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com
REDIS_PASSWORD=your-secure-redis-password
REDIS_URL=redis://:your-secure-redis-password@redis:6379/0
DATABASE_URL=postgresql://postgres.yourref:your-password@aws-0-region.pooler.supabase.com:5432/postgres
OUTPUT_DIR=./runtime/renders
PREVIEW_SIGNING_SECRET=your-random-signing-secret-at-least-32-chars
LEAD_HASH_SALT=your-random-salt-at-least-32-chars

# --- TIMEOUTS / WORKERS ---
AI_API_TIMEOUT_SECONDS=120
AI_API_MAX_RETRIES=2
FFMPEG_TIMEOUT_SECONDS=300
FFPROBE_TIMEOUT_SECONDS=30
THUMBNAIL_TIMEOUT_SECONDS=30
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
LOG_LEVEL=INFO

# --- STORAGE (cloud = S3/R2, local = filesystem) ---
STORAGE_MODE=local
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
